# Minimal starting point - camera/ISP-specific tuning (sensor selection, MIPI
# lane count, etc.) is version-specific to the esp_video component you pull
# in, so set those via `idf.py menuconfig` rather than trusting guessed
# symbol names here.

# PSRAM is required for the frame buffers used during photo/video capture.
CONFIG_SPIRAM=y

# Long filenames on the SD card (GOPRO_IMG.jpg / GOPRO_VID.h264 fit in 8.3
# anyway, but this avoids surprises if you rename things later).
CONFIG_FATFS_LFN_HEAP=y

# app_main() needs more stack than the 3.5 KB default once camera + H.264
# buffers are in play.
CONFIG_MAIN_TASK_STACK_SIZE=8192
